# Streamlit 사용자 인증(st.login / st.user) 설정 예시
# 실제 사용 시 이 파일의 이름을 'secrets.toml'로 변경하고 실제 발급받은 OAuth 클라이언트 정보를 입력하세요.
# 참고 공식 문서: https://docs.streamlit.io/develop/api-reference/user

[auth]
# 로컬 개발 환경 리디렉션 URI (Google Cloud Console 등 공급자의 승인된 리디렉션 URI와 일치해야 함)
redirect_uri = "http://localhost:8501/oauth2callback"

# 쿠키 암호화용 비밀키 (임의의 32자 이상 무작위 문자열)
cookie_secret = "replace-with-a-very-long-random-string-at-least-32-chars"

# OpenID Connect (OIDC) 공급자 정보 (기본 예시: Google OAuth 2.0)
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

