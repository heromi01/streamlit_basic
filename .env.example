# ==============================================================================
# 환경 변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성하고 실제 키 값을 입력하세요.
# ==============================================================================

# 1. OpenAI API 키 설정
OPENAI_API_KEY=your_openai_api_key_here

# 2. Streamlit 공식 사용자 인증 (Google OIDC) 환경설정
# .streamlit/secrets.toml 대신 .env에서 직접 로드하여 관리합니다.
AUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
AUTH_COOKIE_SECRET=your_32_char_random_cookie_secret_here
AUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
AUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
AUTH_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
